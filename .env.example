# Copy to .env.local for local development (scripts/setup.sh does this for you).
MONGODB_URI=mongodb://localhost:27017/buildplay
# 32+ char secret used to sign session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Where uploaded manufacturer quotes / source documents are stored.
UPLOAD_DIR=./uploads
